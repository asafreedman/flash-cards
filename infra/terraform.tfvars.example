# Required: replace with an image built from this repository.
app_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/flash-cards-prod-app:latest"

# Optional CI/CD pipeline (GitHub -> CodeBuild -> ECS deploy)
enable_ci_pipeline = false
github_repo_owner  = "your-github-owner"
github_repo_name   = "flash-cards"
github_branch      = "main"
# Optional: use an existing CodeStar connection ARN instead of creating one.
# github_connection_arn = "arn:aws:codestar-connections:us-east-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

aws_region       = "us-east-1"
project_name     = "flash-cards"
environment      = "prod"
domain_name      = "flash-cards.asafreedman.com"
hosted_zone_name = "asafreedman.com"

# Cost/scale tuning
desired_count = 1
min_count     = 1
max_count     = 2

# Optional resiliency tradeoff (higher cost)
db_multi_az = false

# Optional: small-instance PostgreSQL tuning
enable_small_instance_db_tuning = true
db_max_connections              = 90
